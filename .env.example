# Field Shift — variables de entorno. Copia este archivo y llena los valores:
#   backend:  copia a backend/.env
#   frontend: copia a frontend/.env.local (solo las NEXT_PUBLIC_*)
# Nunca subas un .env con valores (AGENTS.md regla 8).

# ---------- Backend (Railway y local) ----------
# fixture = sirve /contracts/fixtures tal cual, con data_status "fixture"
# real    = usa tablas precalculadas de /data-pipeline (aún no disponible)
DATA_MODE=fixture

# Orígenes permitidos por CORS, separados por coma
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
# Expresión regular para los dominios de Vercel (producción y vistas previas)
CORS_ORIGIN_REGEX=https://.*\.vercel\.app

# Supabase: si faltan, /share responde 503 y lo demás sigue funcionando
SUPABASE_URL=
SUPABASE_ANON_KEY=

# NASA POWER (sin llave)
POWER_TIMEOUT_S=15
POWER_CACHE_DIR=.cache/power

# Carpeta con los artefactos de modelos (model_1_crop_water/, ...)
MODELS_DIR=artifacts

# ---------- Frontend (Vercel y local) ----------
NEXT_PUBLIC_API_URL=http://localhost:8010
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# ---------- Datos y modelos (solo Colab o máquina rentada) ----------
# Proyecto de Google Cloud registrado en Earth Engine
EE_PROJECT=
# Token de Earthdata Login (HLS, SMAP por earthaccess)
EARTHDATA_TOKEN=
