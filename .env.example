# Field Shift — variables de entorno. Copia este archivo y llena los valores:
#   backend:  copia a backend/.env
#   frontend: copia a frontend/.env.local (solo las NEXT_PUBLIC_*)
# Nunca subas un .env con valores (AGENTS.md regla 8).

# ---------- Backend (Railway y local) ----------
# fixture = sirve /contracts/fixtures tal cual, con data_status "fixture"
# real    = usa tablas precalculadas de /data-pipeline (aún no disponible)
DATA_MODE=fixture

# Orígenes permitidos por CORS, separados por coma
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
# Expresión regular para los dominios de Vercel (producción y vistas previas)
CORS_ORIGIN_REGEX=https://.*\.vercel\.app

# Supabase: si faltan, /share responde 503 y lo demás sigue funcionando
SUPABASE_URL=
SUPABASE_ANON_KEY=

# NASA POWER (sin llave)
POWER_TIMEOUT_S=15
POWER_CACHE_DIR=.cache/power

# Carpeta con los artefactos de modelos (model_1_crop_water/, ...)
MODELS_DIR=artifacts

# Análisis en vivo de un punto (/api/v1/analyze) con Google Earth Engine.
# Sin EE_PROJECT la ruta responde 503 y lo demás sigue funcionando.
# EE_SERVICE_ACCOUNT_JSON: contenido completo del JSON de la cuenta de servicio
# (una sola línea). Solo en Railway o en backend/.env, nunca en el repositorio.
EE_PROJECT=
EE_SERVICE_ACCOUNT_JSON=
LIVE_CACHE_DIR=.cache/live

# Guía tutorial (/api/v1/guide). Sin GUIDE_LLM_API_KEY responde la capa sin IA.
# La llave va solo en Railway o en backend/.env; nunca en una variable NEXT_PUBLIC_.
GUIDE_LLM_API_KEY=
# anthropic (por omisión) o gemini
GUIDE_LLM_PROVIDER=anthropic
# Vacío = modelo por omisión del proveedor (claude-opus-5-5 o gemini-2.5-flash)
GUIDE_LLM_MODEL=
GUIDE_TIMEOUT_S=8

# ---------- Frontend (Vercel y local) ----------
NEXT_PUBLIC_API_URL=http://localhost:8010
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# ---------- Datos y modelos (solo Colab o máquina rentada) ----------
# Proyecto de Google Cloud registrado en Earth Engine
EE_PROJECT=luca-497507
# Token de Earthdata Login (HLS, SMAP por earthaccess)
EARTHDATA_TOKEN=

# ---------- Llaves de datos de apoyo (registro gratuito) ----------
# USDA NASS QuickStats: quickstats.nass.usda.gov/api
NASS_QUICKSTATS_KEY=
# OpenET: etdata.org
OPENET_API_KEY=
# USDA AMS MyMarketNews: mymarketnews.ams.usda.gov
AMS_MARS_KEY=
